# Скопируйте этот файл в .env и заполните. Сам .env в git не попадает.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Supabase → Settings → API: адрес проекта и секретный (service_role) ключ
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Необязательно
# ADMIN_ID=            главный админ (Telegram ID, узнать командой /id в боте)
# EXTRA_ADMIN_IDS=     дополнительные админы через запятую
# ADMIN_TG=            контакт админа для пользователей, например @username
# ADMIN_PHONE=         телефон админа для пользователей
# WEBAPP_URL=          публичный HTTPS-адрес Mini App (на сервере с доменом); без него — временный туннель
# WEB_HOST=127.0.0.1
# WEB_PORT=8080
# MINIAPP_DEV=         1 — вход без Telegram для разработки, только на своём компьютере. На сервере не включать
